function adminUpsertUser_(token,incoming){const admin=requireAdmin_(token),data=data_();if(!incoming||!incoming.username||!incoming.name||!incoming.role)throw new Error('이름, 아이디, 역할은 필수입니다.');if(['admin','viewer','student'].indexOf(incoming.role)===-1)throw new Error('올바른 역할을 선택하세요.');if(incoming.role==='student'&&!data.students.some(function(x){return x.id===incoming.studentId&&x.active;}))throw new Error('학생 계정은 활성 학생과 연결해야 합니다.');const studentId=incoming.role==='student'?(incoming.studentId||''):'';let user=data.accounts.find(function(x){return x.id===incoming.id;});if(data.accounts.some(function(x){return(!user||x.id!==user.id)&&x.username===incoming.username;}))throw new Error('이미 사용 중인 아이디입니다.');if(user){const before=copy_(user);assertLastAdmin_(data,user.id,incoming);Object.assign(user,{username:incoming.username,name:incoming.name,role:incoming.role,studentId:studentId,active:incoming.active!==false});if(incoming.password){user.salt=Utilities.getUuid();user.s=user.salt;user.passwordHash=hash_(incoming.password,user.salt);user.h=user.passwordHash;}if(sensitiveAccountChange_(before,user))user.authVersion=authVersion_(before)+1;}else{if(!incoming.password)throw new Error('새 계정의 초기 비밀번호를 입력하세요.');user=makeUser_({id:Utilities.getUuid(),username:incoming.username,name:incoming.name,role:incoming.role,studentId:studentId,active:incoming.active!==false},incoming.password);data.accounts.push(user);}saveData_(data);return{ok:true,data:dataForUser_(data,admin)};}
function adminDeleteUser_(token,userId){const admin=requireAdmin_(token),data=data_();if(admin.id===userId)throw new Error('현재 로그인한 관리자 계정은 삭제할 수 없습니다.');assertLastAdmin_(data,userId,null);data.accounts=data.accounts.filter(function(x){return x.id!==userId;});saveData_(data);return{ok:true,data:dataForUser_(data,admin)};}
function withLock_(callback){if(lockDepth_)return callback();const lock=LockService.getScriptLock();lock.waitLock(10000);lockDepth_++;try{return callback();}finally{lockDepth_--;lock.releaseLock();}}

function studentCreateSwap_(token,incoming){const user=requireStudent_(token),data=data_(),student=studentForUser_(data,user);if(!incoming||!incoming.scheduleId||!incoming.date||!incoming.reason)throw new Error('대상 일정과 사유를 입력하세요.');const schedule=data.schedules.find(function(x){return x.id===incoming.scheduleId&&x.studentId===student.id&&x.site===student.site&&x.semesterId===data.settings.activeSemesterId;});if(!schedule)throw new Error('현재 학기의 본인 근무만 요청할 수 있습니다.');const occurrence=eventsForDate_(data,student.site,incoming.date,data.settings.activeSemesterId,student.id).find(function(x){return x.id===schedule.id;});if(!occurrence||occurrence.isSubstitute)throw new Error('해당 날짜에 본인이 실제 근무자로 지정된 일정이 아닙니다.');if(data.swaps.some(function(x){return x.scheduleId===schedule.id&&x.date===incoming.date&&['반려','취소'].indexOf(x.status)===-1;}))throw new Error('같은 근무에 진행 중인 대타 요청이 있습니다.');data.swaps.unshift({id:Utilities.getUuid(),scheduleId:schedule.id,site:student.site,semesterId:data.settings.activeSemesterId,requesterId:user.id,requesterStudentId:student.id,requesterName:student.name,date:incoming.date,reason:incoming.reason,status:'모집중',applicants:[],assigneeId:'',assigneeName:'',adminNote:'',createdAt:new Date().toISOString()});saveData_(data);return{ok:true,data:dataForUser_(data,user)};}
