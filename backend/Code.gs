function rawEventsForDate_(data,site,date,semesterId,onlyStudentId){const key=typeof date==='string'?date:Utilities.formatDate(date,TIMEZONE,'yyyy-MM-dd'),semester=data.semesters.find(function(s){return s.id===semesterId;});if(semester&&((semester.startDate&&key<semester.startDate)||(semester.endDate&&key>semester.endDate)))return[];const day=dateTime_(key,'12:00').getDay(),exceptions=data.exceptions.filter(function(x){return x.site===site&&x.semesterId===semesterId&&x.date===key;}),regular=data.schedules.filter(function(x){return x.site===site&&x.semesterId===semesterId&&(!x.effectiveFrom||key>=x.effectiveFrom)&&(!x.effectiveUntil||key<=x.effectiveUntil)&&(x.kind==='weekly'?Number(x.weekday)===day:x.date===key);}).reduce(function(all,item){const exception=exceptions.find(function(e){return e.scheduleId===item.id&&e.type!=='add';});if(exception&&exception.type==='cancel')return all;all.push(Object.assign({},item,exception&&exception.type==='change'?{start:exception.start,end:exception.end,exceptionId:exception.id,exceptionType:'change'}:{}));return all;},[]);exceptions.filter(function(x){return x.type==='add';}).forEach(function(x){regular.push({id:x.id,site:x.site,semesterId:x.semesterId,studentId:x.studentId,studentName:x.studentName,kind:'date',date:x.date,start:x.start,end:x.end,exceptionId:x.id,exceptionType:'add'});});const resolved=regular.map(function(item){const swap=data.swaps.find(function(s){return s.scheduleId===item.id&&s.date===key&&s.status==='대타확정'&&s.assigneeId;}),event=swap?Object.assign({},item,{originalStudentId:item.studentId,originalStudentName:item.studentName,studentId:swap.assigneeId,studentName:swap.assigneeName,isSubstitute:true,swapId:swap.id}):item;return Object.assign({},event,{workDate:key,sourceType:'schedule',workInstanceId:'schedule:'+item.id+':'+key});});data.extraJobs.filter(function(job){return job.site===site&&job.semesterId===semesterId&&job.date===key&&job.status!=='CANCELLED';}).forEach(function(job){(job.applicants||[]).fil