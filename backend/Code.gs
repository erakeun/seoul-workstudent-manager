function adminUpdateSwap_(token,swapId,status,note,assigneeId){const admin=requireAdmin_(token);return withLock_(function(){const data=data_(),swap=data.swaps.find(function(x){return x.id===swapId;});if(!swap)throw new Error('대타 요청을 찾을 수 없습니다.');if(status==='대타확정'){const assignee=data.students.find(function(x){return x.id===assigneeId&&x.active;}),occurrence=eventsForDate_(data,swap.site,swap.date,swap.semesterId,swap.requesterStudentId).find(function(x){return x.id===swap.scheduleId;});if(!assignee||assignee.site!==swap.site)throw new Error('같은 근무지의 활성 학생만 대타로 확정할 수 있습니다.');if(!(swap.applicants||[]).some(function(x){return x.studentId===assignee.id;}))throw new Error('가져가기를 신청한 학생만 확정할 수 있습니다.');if(!occurrence||hasConflict_(data,assignee.id,swap.date,occurrence.start,occurrence.end,''))throw new Error('대타 학생의 기존 근무와 시간이 겹칩니다.');swap.assigneeId=assignee.id;swap.assigneeName=assignee.name;}else if(status==='반려'){swap.assigneeId='';swap.assigneeName='';}swap.status=status;swap.adminNote=note||'';swap.updatedAt=new Date().toISOString();saveData_(data);return{ok:true,data:dataForUser_(data,admin)};});}

function adminUpsertExtraJob_(token,incoming){const admin=requireAdmin_(token),data=data_();if(!incoming||!incoming.title||!incoming.place||!incoming.date||!incoming.start||!incoming.end||Number(incoming.capacity)<1)throw new Error('구인 정보를 모두 입력하세요.');if(minutes_(incoming.end)<=minutes_(incoming.start))throw new Error('종료시간은 시작시간보다 늦어야 합니다.');if(['general','holmz'].indexOf(incoming.site)===-1)throw new Error('올바른 근무지를 선택하세요.');let job=data.extraJobs.find(function(x){return x.id===incoming.id;});const activeCount=job?(job.applicants||[]).filter(function(a){return a.status!=='CANCELLED'&&a.status!=='REJECTED';}).length:0;if(Number(incoming.capacity)<activeCount)throw new Error('현재 신청자 수보다 모집인원을 줄일 수 없습니다.');const fields={semesterId:data.settings.activeSemesterId,site:incoming.site,title:incoming.title,place:incoming.place,date:incoming.date,start:incoming.start,end:incoming.end,capacity:Number(incoming.capacity),description:incoming.description||'',status:incoming.status==='CLOSED'?'CLOSED':'OPEN',updatedAt:new Date().toISOString()};if(job)Object.assign(job,fields);else{job=Object.assign({id:Utilities.getUuid(),applicants:[],createdAt:new Date().toISOString(),createdBy:admin.id},fields);data.extraJobs.unshift(job);}saveData_(data);return{ok:true,data:dataForUser_(data,admin)};}
function studentApplyExtraJob_(token,jobId){const user=requireStudent_(token);return withLock_(function(){const data=data_(),student=studentForUser_(data,user),job=data.extraJobs.find(function(x){return x.id===jobId;});if(!job||job.status!=='OPEN'||job.semesterId!==data.settings.activeSemesterId)throw new Error('현재 신청 가능한 구인이 아닙니다.');if(job.site!==student.site)throw new Error('다른 근무지의 구인에는 신청할 수 없습니다.');job.applicants=job.applicants||[];if(job.applicants.some(function(a){return a.studentId===student.id&&a.status!=='CANCELLED'&&a.status!=='REJECTED';}))throw new Error('이미 신청한 구인입니다.');const activeCount=job.applicants.filter(function(a){return a.status!=='CANCELLED'&&a.status!=='REJECTED';}).length;if(activeCount>=Number(job.capacity))throw new Error('모집 정원이 마감되었습니다.');if(hasConflict_(data,student.id,job.date,job.start,job.end,''))throw new Error('기존 근무와 시간이 겹칩니다.');job.applicants.push({studentId:student.id,name:student.name,status:'APPLIED',appliedAt:new Date().toISOString()});saveData_(data);return{ok:true,data:dataForUser_(data,user)};});}
function studentCancelExtraJob_(token,jobId){const user=requireStudent_(token);return withLock_(function(){const data=data_(),student=studentForUser_(data,user),job=data.extraJobs.find(function(x){return x.id===jobId&&x.site===student.site;});if(!job||job.status!=='OPEN')throw new Error('모집 중인 구인만 신청 취소할 수 있습니다.');const application=(job.applicants||[]).find(function(a){return a.studentId===student.id&&a.status!=='CANCELLED'&&a.status!=='REJECTED';});if(!application)throw new Error('신청 내역을 찾을 수 없습니다.');if(application.status==='CONFIRMED')throw new Error('관리자가 확정한 추가근무는 취소할 수 없습니다.');application.status='CANCELLED';application.cancelledAt=new Date().toISOString();saveData_(data);return{ok:true,data:dataForUser_(data,user)};});}
function adminUpdateExtraApplicant_(token,jobId,studentId,status){const admin=requireAdmin_(token);return withLock_(function(){const data=data_(),job=data.extraJobs.find(function(x){return x.id===jobId;}),student=data.students.find(function(x){return x.id===studentId&&x.active;});if(!job||!student||student.site!==job.site)throw new Error('구인 또는 같은 근무지 신청자를 찾을 수 없습니다.');const application=(job.applicants||[]).find(function(a){return a.studentId===studentId&&a.status!=='CANCELLED';});if(!application)throw new Error('신청 내역을 찾을 수 없습니다.');if(status==='CONFIRMED'){const confirmed=job.applicants.filter(function(a){return a.status==='CONFIRMED'&&a.studentId!==studentId;}).length;if(confirmed>=Number(job.capacity))throw new Error('확정 정원이 마감되었습니다.');if(hasConflict_(data,student.id,job.date,job.start,job.end,'extra:'+job.id+':'+student.id+':'+job.date))throw new Error('학생의 기존 근무와 시간이 겹칩니다.');}if(['CONFIRMED','REJECTED'].indexOf(status)===-1)throw new Error('올바른 처리 상태가 아닙니다.');application.status=status;application.updatedAt=new Date().toISOString();application.updatedBy=admin.id;saveData_(data);return{ok:true,data:dataForUser_(data,admin)};});}
function adminCancelExtraJob_(token,jobId){const admin=requireAdmin_(token),data=data_(),job=data.extraJobs.find(function(x){return x.id===jobId;});if(!job)throw new Error('구인을 찾을 수 없습니다.');if(job.date<today_()&&data.attendances.some(function(a){return a.sourceType==='extra'&&a.workInstanceId.indexOf('extra:'+job.id+':')===0;}))throw new Error('근태 기록이 있는 지난 구인은 취소할 수 없습니다.');job.status='CANCELLED';job.updatedAt=new Date().toISOString();job.updatedBy=admin.id;saveData_(data);return{ok:true,data:dataForUser_(data,admin)};}

function studentCheckIn_(token,workInstanceId){const user=requireStudent_(token);return withLock_(function(){const data=data_(),student=studentForUser_(data,user),event=resolveWorkInstance_(data,workInstanceId),existing=data.attendances.find(function(a){return a.workInstanceId===workInstanceId;});validateAttendanceOwner_(data,event,student);if(event.workDate!==today_())throw new Error('오늘 근무만 출근 처리할 수 있습니다.');if(existing&&existing.checkoutType==='ABSENT')throw new Error('관리자가 결근 처리한 근무입니다. 관리자에게 문의하세요.');if(existing&&existing.actualCheckIn)throw new Error('이미 출근 처리되었습니다.');const now=new Date().toISOString(),record=Object.assign({},existing||{},{attendanceId:existing?existing.attendanceId:Utilities.getUuid(),workInstanceId:workInstanceId,semesterId:event.semesterId,site:event.site,studentId:event.studentId,scheduleId:event.id,sourceType:event.sourceType,workDate:event.workDate,scheduledStart:event.start,scheduledEnd:event.end,actualCheckIn:now,actualCheckOut:'',checkoutType:'',correctedByAdmin:existing?existing.correctedByAdmin:false,createdAt:existing?existing.createdAt:now,updatedAt:now});data.attendances=data.attendances.filter(function(a){return a.workInstanceId!==workInstanceId;});data.attendances.push(record);captureAttendance_(data,event);saveData_(data);return{ok:true,data:dataForUser_(data,user)};});}
function studentCheckOut_(token,workInstanceId){const user=requireStudent_(token);return withLock_(function(){const data=data_(),student=studentForUser_(data,user),event=resolveWorkInstance_(data,workInstanceId),attendance=data.attendances.find(function(a){return a.workInstanceId===workInstanceId;});validateAttendanceOwner_(data,event,student);if(!attendance||!attendance.actualCheckIn)throw new Error('출근 기록을 찾을 수 없습니다.');if(attendance.actualCheckOut)throw new Error('이미 퇴근 처리되었습니다.');if(event.workDate!==today_())throw new Error('오늘 근무만 퇴근 처리할 수 있습니다.');const now=new Date(),scheduledEnd=dateTime_(event.workDate,event.end);attendance.actualCheckOut=now.toISOString();attendance.checkoutType=now<scheduledEnd?'EARLY_MANUAL':'MANUAL';attendance.updatedAt=attendance.actualCheckOut;captureAttendance_(data,event);saveData_(data);return{ok:true,data:dataForUser_(data,user)};});}
function adminCorrectAttendance_(token,workInstanceId,actualCheckIn,actualCheckOut,reason){
  const admin=requireAdmin_(token),data=data_(),event=resolveWorkInstance_(data,workInstanceId);
  if(!reason)throw new Error('보정 사유를 입력하세요.');
  if(actualCheckOut&&!actualCheckIn)throw new Error('퇴근 기록에는 출근 기록이 필요합니다.');
  if(actualCheckIn&&isNaN(new Date(actualCheckIn).getTime()))throw new Error('올바른 출근시간이 아닙니다.');
  if(actualCheckOut&&isNaN(new Date(actualCheckOut).getTime()))throw new Error('올바른 퇴근시간이 아닙니다.');
  if(actualCheckIn&&actualCheckOut&&new Date(actualCheckOut)<new Date(actualCheckIn))throw new Error('퇴근시간은 출근시간보다 늦어야 합니다.');
  const before=data.attendances.find(function(a){return a.workInstanceId===workInstanceId;}),now=new Date().toISOString(),record=Object.assign({},before||{},{attendanceId:before?before.attendanceId:Utilities.getUuid(),workInstanceId:workInstanceId,semesterId:event.semesterId,site:event.site,studentId:event.studentId,scheduleId:event.id,sourceType:event.sourceType,workDate:event.workDate,scheduledStart:event.start,scheduledEnd:event.end,actualCheckIn:actualCheckIn||'',actualCheckOut:actualCheckOut||'',checkoutType:actualCheckOut?'ADMIN_CORRECTED':'',correctedByAdmin:true,createdAt:before?before.createdAt:now,updatedAt:now});
  data.attendances=data.attendances.filter(function(a){return a.workInstanceId!==workInstanceId;});data.attendances.push(record);captureAttendance_(data,event);
  data.attendanceAudit.push({id:Utilities.getUuid(),attendanceId:record.attendanceId,workInstanceId:workInstanceId,before:before?copy_(before):null,after:copy_(record),reason:reason,adminId:admin.id,adminName:admin.name,createdAt:now});
  saveData_(data);return{ok:true,data:dataForUser_(data,admin)};
}

function adminMarkAbsent_(token,workInstanceId,reason){
  const admin=requireAdmin_(token),data=data_(),event=resolveWorkInstance_(data,workInstanceId),now=new Date();
  if(event.workDate!==today_())throw new Error('결근은 당일 근무만 처리할 수 있습니다.');
