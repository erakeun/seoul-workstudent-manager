  data.attendances=data.attendances.filter(function(a){return a.workInstanceId!==workInstanceId;});data.attendances.push(record);
  data.attendanceAudit.push({id:Utilities.getUuid(),attendanceId:record.attendanceId,workInstanceId:workInstanceId,before:existing?copy_(existing):null,after:copy_(record),reason:'결근 처리: '+record.absenceReason,adminId:admin.id,adminName:admin.name,createdAt:recordedAt});
  saveData_(data);return{ok:true,data:dataForUser_(data,admin)};
}

function adminRestoreAbsent_(token,workInstanceId,reason){
  const admin=requireAdmin_(token),data=data_(),event=resolveWorkInstance_(data,workInstanceId),existing=data.attendances.find(function(a){return a.workInstanceId===workInstanceId;});
  if(!existing||existing.checkoutType!=='ABSENT')throw new Error('복구할 결근 기록이 없습니다.');
  const recordedAt=new Date().toISOString();data.attendances=data.attendances.filter(function(a){return a.workInstanceId!==workInstanceId;});
  data.attendanceAudit.push({id:Utilities.getUuid(),attendanceId:existing.attendanceId,workInstanceId:workInstanceId,before:existing,after:null,reason:'결근 취소'+(reason?': '+reason:''),adminId:admin.id,adminName:admin.name,createdAt:recordedAt});
  saveData_(data);return{ok:true,data:dataForUser_(data,admin)};
}

function createHandoverNote_(token,content,requestedSite){
  const user=requireUser_(token),data=data_(),text=String(content||'').trim();
  if(['admin','student'].indexOf(user.role)===-1)throw new Error('공유 메모 작성 권한이 없습니다.');
  if(!text)throw new Error('메모 내용을 입력하세요.');
  if(text.length>500)throw new Error('메모는 500자 이내로 작성하세요.');
  const site=user.role==='student'?studentForUser_(data,user).site:String(requestedSite||'');
  if(['general','holmz'].indexOf(site)===-1)throw new Error('올바른 근무지를 선택하세요.');
  if(data.handoverNotes.length>=200)throw new Error('공유 메모는 최대 200건까지 보관됩니다. 오래된 메모를 확인 후 삭제하세요.');
  data.handoverNotes.unshift({id:Utilities.getUuid(),site:site,authorUserId:user.id,authorName:user.name,content:text,createdAt:new Date().toISOString()});
  saveData_(data);return{ok:true,data:dataForUser_(data,user)};
}
function deleteHandoverNote_(token,noteId){
  const user=requireUser_(token),data=data_(),note=data.handoverNotes.find(function(x){return x.id===noteId;});
  if(!note)throw new Error('공유 메모를 찾을 수 없습니다.');
  if(user.role==='viewer'||(user.role!=='admin'&&note.authorUserId!==user.id))throw new Error('이 공유 메모를 삭제할 권한이 없습니다.');
  data.handoverNotes=data.handoverNotes.filter(function(x){return x.id!==noteId;});
  saveData_(data);return{ok:true,data:dataForUser_(data,user)};
}

function studentMarkNoticeRead_(token,noticeId){const user=requireStudent_(token),data=data_(),student=studentForUser_(data,user),notice=data.notices.find(function(x){return x.id===noticeId;});if(!notice||notice.semesterId!==data.settings.activeSemesterId||['all',student.site].indexOf(notice.site)===-1)throw new Error('확인할 수 없는 공지입니다.');notice.readBy=notice.readBy||[];if(notice.readBy.indexOf(user.id)===-1)notice.readBy.push(user.id);saveData_(data);return{ok:true};}

function studentUploadProfilePhoto_(token,photo){const user=requireStudent_(token),data=data_(),student=studentForUser_(data,user),dataUrl=String(photo&&photo.dataUrl||''),match=dataUrl.match(/^data:(image\/(?:jpeg|png));base64,([A-Za-z0-9+/=]+)$/i);if(!match)throw new Error('JPG 또는 PNG 사진만 업로드할 수 있습니다.');const bytes=Utilities.base64Decode(match[2]);if(!bytes.length||bytes.length>500000)throw new Error('압축 후 500KB 이하 사진만 업로드할 수 있습니다.');const mime=match[1].toLowerCase(),folder=profilePhotoFolder_(),oldId=student.photoFileId||'',extension=mime==='image/png'?'png':'jpg',file=folder.createFile(Utilities.newBlob(bytes,mime,'student-profile-'+student.id+'.'+extension));student.photoFileId=file.getId();student.photoUpdatedAt=new Date().toISOString();saveData_(data);/* Previous photo files remain available to restore older backups. */return{ok:true,data:dataForUser_(data,user)};}
function getProfilePhoto_(token,studentId){const user=requireUser_(token),data=data_(),student=data.students.find(function(x){return x.id===studentId&&x.active;});if(!student)throw new Error('학생 정보를 찾을 수 없습니다.');if(user.role!=='admin'&&user.studentId!==student.id)throw new Error('본인 증명사진만 볼 수 있습니다.');if(!student.photoFileId)return{ok:true,dataUrl:''};const blob=DriveApp.getFileById(student.photoFileId).getBlob(),bytes=blob.getBytes();if(bytes.length>500000)throw new Error('사진 파일이 너무 큽니다.');return{ok:true,dataUrl:'data:'+blob.getContentType()+';base64,'+Utilities.base64Encode(bytes)};}
function profilePhotoFolder_(){const props=PropertiesService.getScriptProperties(),id=props.getProperty(PROFILE_PHOTO_FOLDER_KEY);if(id)try{return DriveApp.getFolderById(id);}catch(_){}const folder=DriveApp.createFolder('서울 총무팀 근로장학생 증명사진');props.setProperty(PROFILE_PHOTO_FOLDER_KEY,folder.getId());return folder;}

function normalizeData_(raw){const data=JSON.parse(JSON.stringify(raw||{}));data.version=4;data.settings=data.settings||{};data.semesters=Array.isArray(data.semesters)&&data.semesters.length?data.semesters:[{id:'semester-2026-2',name:'2026-2학기',startDate:'2026-09-01',endDate:'2027-02-28',active:true,budgets:{general:{total:0,wage:0,rates:{}},holmz:{total:0,wage:0,rates:{}}}}];data.semesters.forEach(function(s){s.budgets=s.budgets||{};s.budgets.general=Object.assign({total:0,wage:0,rates:{}},s.budgets.general||{});s.budgets.holmz=Object.assign({total:0,wage:0,rates:{}},s.budgets.holmz||{});});data.settings.activeSemesterId=data.settings.activeSemesterId||(data.semesters.find(function(s){return s.active;})||data.semesters[0]).id;const semesterId=data.settings.activeSemesterId;data.students=(data.students||[]).map(function(s,i){return Object.assign({studentNumber:'',phone:'',email:'',active:true,color:colorFor_(s.id||String(i)),semesterIds:[semesterId]},s);});data.schedules=(data.schedules||[]).map(function(x){return Object.assign({semesterId:semesterId},x);});data.exceptions=(data.exceptions||[]).map(function(x){return Object.assign({semesterId:semesterId},x);});data.notices=(data.notices||[]).map(function(x){return Object.assign({site:'all',important:false,semesterId:semesterId,readBy:[]},x);});data.handovers=(data.handovers||[]).map(function(x){return Object.assign({site:'all',important:false,url:'',semesterId:semesterId},x);});data.handoverNotes=Array.isArray(data.handoverNotes)?data.handoverNotes:[];data.swaps=(data.swaps||[]).map(function(x){return Object.assign({applicants:[],semesterId:semesterId},x);});data.extraJobs=(data.extraJobs||[]).map(function(x){return Object.assign({applicants:[],status:'OPEN',description:'',place:'',createdAt:'',createdBy:'',semesterId:semesterId},x);});data.attendances=(data.attendances||[]).map(function(x){return Object.assign({actualCheckIn:'',actualCheckOut:'',checkoutType:'',sourceType:'schedule',correctedByAdmin:false,createdAt:'',updatedAt:''},x);});data.attendanceAudit=Array.isArray(data.attendanceAudit)?data.attendanceAudit:[];data.accounts=data.accounts||[];return data;}
function dataForUser_(data,user){data=normalizeData_(data);if(user.role==='student')return publicStudentData_(data,user);if(user.role==='admin')return publicAdminData_(data);if(user.role==='viewer')return publicViewerData_(data);const student=studentForUser_(data,user),site=student.site,semesterId=data.settings.activeSemesterId,semesters=data.semesters.map(function(x){return{id:x.id,name:x.name,startDate:x.startDate,endDate:x.endDate,active:x.active,budgets:{general:{total:0,wage:0},holmz:{total:0,wage:0}}};}),extraJobs=data.extraJobs.filter(function(x){return x.site===site&&x.semesterId===semesterId;}).map(function(x){const safe=Object.assign({},x);safe.applicantCount=(x.applicants||[]).filter(function(a){return a.status!=='CANCELLED'&&a.status!=='REJECTED';}).length;safe.applicants=(x.applicants||[]).filter(function(a){return a.studentId===student.id||a.status==='CONFIRMED';}).map(function(a){return a.studentId===student.id?a:{studentId:a.studentId,name:a.name,status:'CONFIRMED'};});return safe;}),attendances=data.attendances.filter(function(x){return x.semesterId===semesterId&&(x.studentId===student.id||(x.site===site&&x.checkoutType==='ABSENT'));}).map(function(x){return x.studentId===student.id?x:{workInstanceId:x.workInstanceId,semesterId:x.semesterId,site:x.site,studentId:x.studentId,workDate:x.workDate,checkoutType:'ABSENT'};});return{version:data.version,settings:data.settings,semesters:semesters,students:[safeStudent_(student)],schedules:data.schedules.filter(function(x){return x.site===site&&x.semesterId===semesterId;}),exceptions:data.exceptions.filter(function(x){return x.site===site&&x.semesterId===semesterId;}),notices:data.notices.filter(function(x){return(x.site==='all'||x.site===site)&&x.semesterId===semesterId;}),handovers:data.handovers.filter(function(x){return(x.site==='all'||x.site===site)&&x.semesterId===semesterId;}),handoverNotes:data.handoverNotes.filter(function(x){return x.site===site;}),swaps:data.swaps.filter(function(x){return x.site===site&&x.semesterId===semesterId;}),extraJobs:extraJobs,attendances:attendances,attendanceAudit:[],accounts:[]};}
function publicAdminData_(data){return{version:data.version,settings:data.settings,semesters:data.semesters,students:data.students.map(adminStudent_),schedules:data.schedules,exceptions:data.exceptions,notices:data.notices,handovers:data.handovers,handoverNotes:data.handoverNotes,swaps:data.swaps,extraJobs:data.extraJobs,attendances:data.attendances,attendanceAudit:data.attendanceAudit,accounts:data.accounts.map(publicUser_)};}
