function requireUser_(token){const raw=PropertiesService.getScriptProperties().getProperty(SESSION_PREFIX+token);if(!raw)throw new Error('로그인이 필요하거나 세션이 만료되었습니다.');const session=JSON.parse(raw),expiresAt=session.expiresAt||session.e,userId=session.userId||session.id;if(expiresAt<Date.now()){PropertiesService.getScriptProperties().deleteProperty(SESSION_PREFIX+token);throw new Error('세션이 만료되었습니다. 다시 로그인하세요.');}const user=data_().accounts.find(function(x){return x.id===userId&&x.active;});if(!user)throw new Error('사용할 수 없는 계정입니다.');if(session.authVersion===undefined||Number(session.authVersion)!==authVersion_(user))throw Error('계정 권한이 변경되었습니다. 다시 로그인하세요.');return user;}
function requireAdmin_(token){const user=requireUser_(token);if(user.role!=='admin')throw new Error('관리자 권한이 필요합니다.');return user;}
