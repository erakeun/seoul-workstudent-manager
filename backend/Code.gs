  if(existing&&existing.checkoutType==='ABSENT')throw new Error('이미 결근 처리된 근무입니다.');
  if(existing&&(existing.actualCheckIn||existing.actualCheckOut))throw new Error('출퇴근 기록이 있는 근무는 결근 처리할 수 없습니다.');
