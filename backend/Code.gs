function request_(e) { const params=(e&&e.parameter)||{};let body={};try{body=e&&e.postData&&e.postData.contents?JSON.parse(e.postData.contents):{};}catch(_){}return Object.assign({},body,params,{action:body.action||params.action||''}); }
function dispatch_(req) {
  try {
    const routes={
      login:function(){return login_(req.username,req.password);},logout:function(){return logout_(req.token);},session:function(){return loadApp_(req.token);},loadApp:function(){return loadApp_(req.token);},
      adminMutate:function(){return adminMutate_(req.token,req.changes);},adminExportBackup:function(){return adminExportBackup_(req.token);},adminRestoreBackup:function(){return adminRestoreBackup_(req.token,req.backup,req.expectedChecksum);},adminUpsertUser:function(){return adminUpsertUser_(req.token,req.user);},adminDeleteUser:function(){return adminDeleteUser_(req.token,req.userId);},
      studentCreateSwap:function(){return studentCreateSwap_(req.token,req.swap);},studentApplySwap:function(){return studentApplySwap_(req.token,req.swapId);},adminUpdateSwap:function(){return adminUpdateSwap_(req.token,req.swapId,req.status,req.note,req.assigneeId);},studentMarkNoticeRead:function(){return studentMarkNoticeRead_(req.token,req.noticeId);},studentUploadProfilePhoto:function(){return studentUploadProfilePhoto_(req.token,req.photo);},getProfilePhoto:function(){return getProfilePhoto_(req.token,req.studentId);},
      adminUpsertExtraJob:function(){return adminUpsertExtraJob_(req.token,req.job);},adminUpdateExtraApplicant:function(){return adminUpdateExtraApplicant_(req.token,req.jobId,req.studentId,req.status);},adminCancelExtraJob:function(){return adminCancelExtraJob_(req.token,req.jobId);},studentApplyExtraJob:function(){return studentApplyExtraJob_(req.token,req.jobId);},studentCancelExtraJob:function(){return studentCancelExtraJob_(req.token,req.jobId);},
      studentCheckIn:function(){return studentCheckIn_(req.token,req.workInstanceId);},studentCheckOut:function(){return studentCheckOut_(req.token,req.workInstanceId);},adminCorrectAttendance:function(){return adminCorrectAttendance_(req.token,req.workInstanceId,req.actualCheckIn,req.actualCheckOut,req.reason);},adminMarkAbsent:function(){return adminMarkAbsent_(req.token,req.workInstanceId,req.reason);},adminRestoreAbsent:function(){return adminRestoreAbsent_(req.token,req.workInstanceId,req.reason);},createHandoverNote:function(){return createHandoverNote_(req.token,req.content,req.site);},deleteHandoverNote:function(){return deleteHandoverNote_(req.token,req.noteId);}
    };
