function hasConflict_(data,studentId,date,start,end,excludeInstanceId){const student=data.students.find(function(s){return s.id===studentId;});if(!student)return true;return eventsForDate_(data,student.site,date,data.settings.activeSemesterId,studentId).some(function(x){return x.workInstanceId!==excludeInstanceId&&minutes_(start)<minutes_(x.end)&&minutes_(end)>minutes_(x.start);});}
function resolveWorkInstance_(data,workInstanceId){if(!workInstanceId||!/^((schedule)|(extra)):/.test(workInstanceId))throw new Error('올바른 근무 인스턴스가 아닙니다.');const recorded=data.attendances.find(a=>a.workInstanceId===workInstanceId),snapshot=recorded&&eventFromAttendance_(recorded);if(snapshot)return snapshot;const workDate=workInstanceId.slice(-10),events=['general','holmz'].reduce(function(all,site){return all.concat(eventsForDate_(data,site,workDate,data.settings.activeSemesterId,''));},[]),event=events.find(function(x){return x.workInstanceId===workInstanceId;});if(!event)throw new Error('현재 학기의 실제 근무 일정을 찾을 수 없습니다.');return event;}
function validateAttendanceOwner_(data,event,student){if(event.semesterId!==data.settings.activeSemesterId)throw new Error('현재 학기 근무만 처리할 수 있습니다.');if(event.site!==student.site||event.studentId!==student.id)throw new Error('본인이 실제 근무자로 지정된 일정만 처리할 수 있습니다.');}
function minutes_(value){const parts=String(value||'00:00').split(':');return Number(parts[0])*60+Number(parts[1]);}
function dateTime_(date,time){return new Date(date+'T'+time+':00+09:00');}
function today_(){return Utilities.formatDate(new Date(),TIMEZONE,'yyyy-MM-dd');}
function safeStudent_(student){return{id:student.id,name:student.name,site:student.site,type:student.type,active:student.active,color:student.color,semesterIds:student.semesterIds||[],hasProfilePhoto:!!student.photoFileId};}
